{
  "name": "unifi-viewport-liveview-switcher",
  "version": "1.0.7",
  "description": "Compact desktop widget to switch UniFi Protect Viewport liveviews",
  "main": "out/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "build:intunewin": "npm run build:win && node scripts/build-intunewin.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "unifi",
    "protect",
    "viewport",
    "liveview"
  ],
  "author": "ihrigb",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^7.0.0",
    "vite": "^5.3.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "undici": "^6.19.2"
  }
}
